<h1>商品一覧</h1>

<table>
  <thead>
    <tr>
      <th>商品名</th>
      <th>カテゴリー</th>
    </tr>
  </thead>
  <tbody>
    <% @items.each do |item| %>
      <tr>
        <td><%= item.name %></td>
        <td><%= item.category.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= link_to new_item_path do %>
<div>商品の新規登録</div>
<% end %>
<%= link_to new_store_path do %>
<div>店舗の新規登録</div>
<% end %>
<%= link_to new_price_path do %>
<div>価格の新規登録</div>
<% end %>