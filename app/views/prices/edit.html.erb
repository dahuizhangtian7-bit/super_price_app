<h1>価格変更</h1>

<%= form_with model: @price do |f| %>
  <div>
    <%= @item.name %>
  </div>

  <div>
    <%= f.collection_select :store_id, @stores, :id, :name, { prompt: '店舗を選択してください' } %>
  </div>

  <div>
    <%= f.label :price, '価格(円)' %>
    <%= f.text_field :price %>
  </div>

  <%= f.submit '変更する' %>
<% end %>