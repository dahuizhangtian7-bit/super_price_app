          <li><%= link_to '商品登録', new_item_path %></li>
          <li><%= link_to '店舗登録', new_store_path %></li>
          <li><%= link_to '価格登録', new_price_path %></li>
        </ul>
      </div>
    </header>
    <%= yield %>
  </body>
</html>
