<!DOCTYPE html>
<html>
  <head>
    <title>スーパー比較アプリ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "https://classic.yarnpkg.com/en/package/destyle.css" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <div class="app_title"><%= link_to 'スーパー比較アプリ', root_path %></div>
      <div>
        <ul class="regi_lists">
          <li class="regi_list"><%= link_to '商品登録', new_item_path %></li>
          <li class="regi_list"><%= link_to '店舗登録', new_store_path %></li>
          <li class="regi_list"><%= link_to '価格登録', new_price_path %></li>
        </ul>
      </div>
    </header>
    <%= yield %>
  </body>
</html>
